# Copy to .env and fill in real values. Never commit .env.
#
# Read by the server (node --env-file=.env apps/server/dist/main.js, or a systemd
# EnvironmentFile) and by docker compose, which substitutes these into the container.
PORT=3000
PM_TOKEN=change-me-shared-secret-for-github-webhooks
NODE_ENV=production

# First-boot admin account (only used the very first time the server starts
# with an empty users table). If ADMIN_PASSWORD is left unset, the server
# generates a random one and prints it once to stdout, then never again.
ADMIN_EMAIL=admin@officepm.local
ADMIN_PASSWORD=

# Where pm.db and uploads/ live. Unset means the repository root, which is where v1 kept
# them; set it to a directory of its own. `pnpm dev` uses .data. In the Docker image it is /data.
# PM_DATA_DIR=/var/lib/officepm

# The built web client. Unset means apps/web/dist in the repository root (`pnpm build:web`).
# PM_WEB_DIR=apps/web/dist

# Project and board definitions. Unset means projects.json in the repository root.
# PM_PROJECTS_FILE=/etc/officepm/projects.json

# Set to 1 when a reverse proxy (Tailscale serve, Caddy, nginx) sits in front, so the
# failed-login throttle keys on the address the proxy reports in X-Forwarded-For
# instead of the proxy's own. Leave unset when the server is reached directly: a
# client could otherwise forge the header.
# PM_TRUST_PROXY=1

# docker compose only: the host address and port the container is published on.
# The default is loopback; 0.0.0.0 serves the whole network.
# PM_HOST_BIND=127.0.0.1
# PM_HOST_PORT=3000
