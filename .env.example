# Copy to .env and fill in real values. Never commit .env.
PORT=3000
PM_TOKEN=change-me-shared-secret-for-github-webhooks
NODE_ENV=production

# First-boot admin account (only used the very first time the server starts
# with an empty users table). If ADMIN_PASSWORD is left unset, the server
# generates a random one and prints it once to stdout, then never again.
ADMIN_EMAIL=admin@officepm.local
ADMIN_PASSWORD=

# v2 server only. Set to 1 when a reverse proxy (Tailscale serve, Caddy, nginx)
# sits in front, so the failed-login throttle keys on the address the proxy
# reports in X-Forwarded-For instead of the proxy's own. Leave unset when the
# server is reached directly: a client could otherwise forge the header.
# PM_TRUST_PROXY=1
