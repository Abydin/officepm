{
  "name": "officepm",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Self-hosted project management for a small office.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:conformance": "node --test tests/conformance/*.test.js",
    "test:conformance:v2": "pnpm run build && OFFICEPM_SERVER_CMD=apps/server/dist/main.js node --test tests/conformance/*.test.js",
    "test": "pnpm run test:conformance && pnpm run test:unit && pnpm run test:data-compat",
    "lint": "eslint .",
    "typecheck": "tsc -b packages/shared apps/server && pnpm --filter @officepm/web typecheck && tsc --noEmit -p tests/data-compat",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm run build && PM_DATA_DIR=.data node apps/server/dist/main.js",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:data-compat": "vitest run --config tests/data-compat/vitest.config.ts",
    "build": "tsc -b packages/shared apps/server",
    "start": "node apps/server/dist/main.js",
    "build:web": "tsc -b packages/shared && pnpm --filter @officepm/web build",
    "dev:web": "tsc -b packages/shared && pnpm --filter @officepm/web dev",
    "test:e2e": "pnpm run build && pnpm run build:web && pnpm --filter @officepm/web test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
